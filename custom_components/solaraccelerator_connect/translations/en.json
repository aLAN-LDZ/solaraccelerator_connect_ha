{
  "title": "Solar Accelerator Connect",
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "Solar Accelerator Connect gateway",
        "description": "Enter the gateway address on your local network. Leave the password empty if the gateway portal does not require one.",
        "data": {
          "host": "IP address or hostname",
          "password": "Portal password"
        }
      },
      "password": {
        "title": "Gateway portal password",
        "description": "Gateway {host} requires the password set during its setup wizard. The username is always \"admin\".",
        "data": {
          "password": "Portal password"
        }
      },
      "prefix": {
        "title": "Entity prefix",
        "description": "Entities will be named like {example}.",
        "data": {
          "prefix": "Prefix"
        }
      },
      "reauth_confirm": {
        "title": "Portal password changed",
        "description": "Gateway {host} rejects the stored password. Enter the current one.",
        "data": {
          "password": "Portal password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the gateway. Check the address and that Home Assistant is on the same network.",
      "invalid_auth": "The gateway rejected the portal password.",
      "setup_incomplete": "The gateway is in access point mode — finish its setup wizard before adding the integration."
    },
    "abort": {
      "already_configured": "This gateway is already configured.",
      "cannot_connect": "Cannot reach the gateway.",
      "reauth_successful": "Password updated."
    }
  },
